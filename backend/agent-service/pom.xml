<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.2</version>
        <relativePath/>
    </parent>

    <groupId>com.intertec.autoops</groupId>
    <artifactId>agent-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>AutoOps Agent Service</name>
    <description>AI agents scoped to a project, quota- and subscription-gated</description>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.5.0</springdoc.version>

        <!-- Model provider SDKs — see src/main/java/.../agent/modelsdk.
             Pinned rather than ranged: an agent runtime that silently changes
             the wire format it speaks to a tenant's paid vendor account is
             not something a dependency update should be able to do. -->
        <openai.sdk.version>4.50.0</openai.sdk.version>
        <anthropic.sdk.version>2.52.0</anthropic.sdk.version>
        <google.genai.sdk.version>1.65.0</google.genai.sdk.version>
        <azure.openai.sdk.version>1.0.0-beta.16</azure.openai.sdk.version>
        <aws.sdk.version>2.51.2</aws.sdk.version>
        <huaweicloud.sdk.version>3.1.210</huaweicloud.sdk.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Validates auth-service RS256 tokens locally via its JWKS endpoint -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===================== Model SDKs =====================
             The vendors' own Java clients, one per kind in the console's
             provider catalog. Each vendor disagrees about authentication and
             wire format, and hand-rolling six of those is how an agent
             runtime ends up subtly wrong on the fifth one; these are the
             clients the vendors themselves test.

             Five of the eleven catalog kinds (Mistral, Groq, DeepSeek, xAI,
             Ollama) speak the OpenAI wire format, so openai-java covers them
             with a base-URL override rather than five more dependencies. -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
            <version>${openai.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.genai</groupId>
            <artifactId>google-genai</artifactId>
            <version>${google.genai.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-ai-openai</artifactId>
            <version>${azure.openai.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>bedrockruntime</artifactId>
            <version>${aws.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.huaweicloud.sdk</groupId>
            <artifactId>huaweicloud-sdk-modelarts</artifactId>
            <version>${huaweicloud.sdk.version}</version>
        </dependency>

        <!-- Test: hermetic H2 profile -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Integration tests only, and the reason is specific: @DataJpaTest
            builds its schema from Hibernate's DDL, NOT from Flyway. Every unit
            test in this module therefore validates a schema no environment
            ever runs, and a migration can be wrong in ways all 71 of them pass.
            V6 proved it: green locally, error 1071 on the real database.

            Version is managed by spring-boot-dependencies.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                *IT tests run in `verify`, never in `test`. They pull a real
                MySQL image and take tens of seconds, which is the wrong price
                to pay on every save and the right one to pay on every push —
                and CI already runs `mvn verify` for this module.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
