{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoops.intertecsys.com/schema/workflow.schema.json",
  "title": "Provider-authored workflow definition",
  "description": "Validation contract for workflows/<DOMAIN>/*.json. Two shapes are legal and they run on different engines. A STEP workflow's nodes[] are job steps walked by core-service's ExecutionEngine on an execution host. A NATIVE workflow's nodes[] are a typed graph with edges[], handed whole to agent-runtime. This file is the SINGLE source of truth for a use case's input form either way: the console renders it, and AgentToolbox turns the same declaration into the model's tool schema.",
  "type": "object",
  "required": [
    "taskId",
    "domain",
    "title",
    "description",
    "runtime",
    "inputs",
    "nodes",
    "requires"
  ],
  "additionalProperties": false,
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^RD-[0-9]{3}$"
    },
    "domain": {
      "type": "string",
      "enum": [
        "AWS",
        "Azure",
        "Active Directory",
        "Exchange On-Premises",
        "Linux",
        "Microsoft 365",
        "Network",
        "SQL Server",
        "Security",
        "VMware",
        "Windows Server",
        "AutoOps"
      ],
      "description": "'AutoOps' is the platform's own plane — workflows that read what happened in the workspace rather than in a vendor's estate. They need no cloud connection because the data is already ours."
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 512
    },
    "category": {
      "type": "string",
      "maxLength": 64
    },
    "runtime": {
      "type": "string",
      "enum": [
        "shell",
        "ssh",
        "powershell",
        "python",
        "rest",
        "terraform",
        "kubernetes",
        "native"
      ],
      "description": "Runner the underlying automation needs. 'native' means the graph executes inside agent-runtime and needs no execution host at all. 'powershell' is currently blocked: job-service has no PowerShell runner or WinRM transport."
    },
    "blockedBy": {
      "type": "string",
      "description": "Present when no runner exists for this runtime yet."
    },
    "sourceScript": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "description": "Form rendered to the operator AND the model's argument contract.",
      "items": {
        "type": "object",
        "required": [
          "variable",
          "label",
          "type",
          "required"
        ],
        "additionalProperties": false,
        "properties": {
          "variable": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
            "description": "Must match a real parameter of the underlying automation."
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "select"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "select only. Becomes enum in the model's tool schema."
          },
          "pattern": {
            "type": "string",
            "description": "ECMA regex the value must match."
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "default": {},
          "placeholder": {
            "type": "string"
          },
          "help": {
            "type": "string",
            "description": "Shown under the field. State the blast radius, not the type."
          },
          "requiredWhen": {
            "type": "object",
            "required": [
              "field",
              "equals"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "equals": {}
            },
            "description": "Conditionally mandatory, e.g. approval reference only when remediating."
          },
          "consumedBy": {
            "type": "string",
            "enum": [
              "node",
              "agent"
            ],
            "default": "node",
            "description": "Who reads this value. 'node' means a {{placeholder}} in a step must use it. 'agent' means it reaches the model as a tool argument and informs its judgement instead — a threshold the model compares against, not a shell flag."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "select"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "options"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "number"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "options"
                ]
              }
            }
          }
        ]
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "description": "Steps ExecutionEngine walks. {{Variable}} placeholders are resolved from the run's inputs.",
      "items": {
        "oneOf": [
          {
            "title": "Step node (ExecutionEngine)",
            "type": "object",
            "required": [
              "type",
              "label"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              },
              "retries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "continueOnError": {
                "type": "boolean"
              }
            }
          },
          {
            "title": "Graph node (agent-runtime)",
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "start",
                  "llm",
                  "platform",
                  "job",
                  "http",
                  "template",
                  "condition",
                  "end"
                ]
              },
              "title": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "requires": {
      "type": "array",
      "description": "What must already be true in the CUSTOMER's workspace before this can run at all. Distinct from inputs[], which is asked at run time: a missing prerequisite is answered by an administrator once, not by an operator per run. Read at delivery so the customer is told what to provide instead of discovering it as a failure.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "customerText"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "cloud_connection",
              "runtime",
              "ssh_access",
              "network_access"
            ]
          },
          "platform": {
            "type": "string",
            "enum": [
              "AWS",
              "AZURE",
              "GCP",
              "OCI"
            ],
            "description": "cloud_connection only. Matched against the tenant's CloudConnection records."
          },
          "runtime": {
            "type": "string",
            "enum": [
              "shell",
              "ssh",
              "powershell",
              "python",
              "rest",
              "terraform",
              "kubernetes"
            ],
            "description": "runtime only. Unsatisfiable runtimes disable Run rather than failing mid-execution."
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Engineering detail, e.g. ec2:DeleteVolume. Shown to an admin, never as the primary text."
          },
          "customerText": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "description": "Plain language, no jargon, no API identifiers. This is the sentence a non-engineer reads when asked to provide it."
          },
          "optional": {
            "type": "boolean",
            "default": false,
            "description": "True when the automation degrades gracefully without it."
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "description": "Native graph only. Transitions between nodes; 'branch' selects an arm of a condition.",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "powershell"
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "required": [
          "blockedBy"
        ]
      }
    }
  ]
}
