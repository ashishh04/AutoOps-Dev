# ---------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------
# Frontend build output and deps (source lives in frontend/).
node_modules/
frontend/dist/
.vite/

# Maven build output
target/
!.mvn/wrapper/maven-wrapper.jar

# Local Maven repository. Docker-based `mvn` runs mount this at the repo root,
# so it fills with hundreds of MB of downloaded jars. `.m2;C*` catches the
# stray dir a malformed -v argument creates on Windows.
.m2/
.m2;C*

# Vitest / JaCoCo coverage output
coverage/
frontend/coverage/

# Python bytecode (reports/build_tracker.py, Scripts/_gen helpers)
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# .env holds the real SendGrid key, OAuth client secrets and the
# cloud-credential encryption key. .env.example is the checked-in template.
.env
*.env.local
.env.*.local
# Stray copy of the same secrets at the repo root, no dot. Real keys inside.
/env
# The ngrok authtoken lives in the root .env too (already ignored above).
# deploy-demo/.env.demo was folded into it; kept here so an old copy can never
# be committed by accident.
deploy-demo/.env.demo
deploy/aws-ec2/.env.prod
.env.prod
*.pem
*.key
!frontend/src/**/*.key
# Java keystores. secrets/jwt-keystore.p12 is generated on the host during
# deploy and signs every access token — it must never reach the repo.
*.p12
*.jks
*.pfx
secrets/

# ---------------------------------------------------------------------------
# Local tooling / IDE
# ---------------------------------------------------------------------------
.idea/
*.iml
.vscode/
.claude/

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Logs and captured build/test output
# ---------------------------------------------------------------------------
*.log
core-test-out.txt
mp-test-out.txt
plugin-test-out.txt
fe-build.txt
*-test-out.txt

# ---------------------------------------------------------------------------
# Internal delivery documents (not source; keep out of the code repo)
# ---------------------------------------------------------------------------
reports/
*.pdf
*.xlsx
*.xls
*.docx
*.pptx

# ---------------------------------------------------------------------------
# Database dumps (data, not code)
# ---------------------------------------------------------------------------
# The 2 MB provider-catalog dump. It is seed DATA, restored from S3 on the
# host — see the deploy runbook. Flyway migrations under
# src/main/resources/db/migration are code and stay tracked.
/library-catalog.sql
*.dump
*.sql.gz
*.mysqldump
# Local-only compose overrides (host port clashes, per-machine tweaks).
docker-compose.override.yml

# Database dumps from scripts/backup-databases.sh. NEVER committed: they carry
# every user's BCrypt hash, every tenant's encrypted credentials and the whole
# catalog. A backup in the repository is a breach waiting for the repository to
# be shared.
backups/

# ---------------------------------------------------------------------------
# Superseded and scratch files (2026-09-26)
# ---------------------------------------------------------------------------
# The code repo is backend/, frontend/, Scripts/ and .github/. Everything
# below was working material that outlived its purpose. It stays in git
# history — these rules only stop it coming back.
#
# Dead component, replaced by frontend/src/pages/AgentsHub.
/agentshub-old.jsx
# Dify workflow exports. Dify itself was removed on 2026-09-19; these are the
# last two designs that were never ported to the native runtime.
/Incident_Postmortem_Writer.yml
/Meeting_Actions_and_Follow-up.yml
# One-off debug queries. Flyway migrations under src/main/resources/db/migration
# are code and stay tracked — these were run by hand against a live schema.
/invariant.sql
/witness.sql
# Scratch harness for the ingest patch.
/patch_ingest_test.py
# Design notes for the first three agents, since built and shipped.
/.specs.txt
# Archived Dify definitions, kept only until the native runtime landed.
/.dify-archive/

# ---------------------------------------------------------------------------
# Generated media / render output
# ---------------------------------------------------------------------------
# Release-video renders from the brag skill: ~99 MB of .mp4/.jpg plus the
# HyperFrames composition that produced them. Regenerable output, and large
# binaries bloat every clone permanently once committed.
/brag-output/
# Lockfile for locally installed Claude Code skills — local tooling, same as
# .claude/ above.
/skills-lock.json

# ---------------------------------------------------------------------------
# Demo stack and seed data (2026-09-26)
# ---------------------------------------------------------------------------
# The code repo is backend/, frontend/, Scripts/ and .github/. These two are
# operational material for the demo host, not source, and they stay in git
# history — the rules below only stop them coming back.
#
# Seed SQL and loader scripts for the demo tenant. Carries a stale tenant id
# since the 2026-08-09 deletion, so it cannot be replayed as-is anyway.
/demo-data/
# The demo overlay: docker-compose.demo.yml, nginx.demo.conf, ngrok config and
# the up/down/status scripts. nginx.demo.conf is what actually serves the demo
# host (the root .env merges this overlay), so removing it from the repo means
# the live demo config now exists ONLY on that host and in git history.
/deploy-demo/

# Downloaded binaries and local skill installs - never source.
# .tools/ holds a 484 MB ffmpeg build; its .exe files exceed GitHub's 100 MB limit.
/.tools/
/.agents/
